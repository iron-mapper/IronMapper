<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IronMapper.Demo</RootNamespace>
    <AssemblyName>IronMapper.Demo</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Demo project — strict warnings are not required -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IronMapper\IronMapper.csproj" />
    <ProjectReference Include="..\..\src\IronMapper.Extensions.DI\IronMapper.Extensions.DI.csproj" />
    <ProjectReference Include="..\..\src\IronMapper.Generator\IronMapper.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
