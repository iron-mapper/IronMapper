<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The global using IronMapper.Generated added by the packed IronMapper package (buildTransitive/IronMapper.props).
    eng/verify-package.ps1 builds this project several times from the local feed, each time with one source file
    (ConsumerSource) and different properties: ImplicitUsings on/off, LangVersion 9, IronMapperImplicitUsings=false,
    a reference to IronMapper.Extensions.DI only (IronMapperPackage), the Quick Start of README.md / README.ru.md, and the
    feature switch of the IMapper registration (PublishTrimmed, IronMapperRegistration, a framework-dependent publish),
    and IM0001 for profiles (IronMapperReportUnmappedInProfiles, .editorconfig severity).
    Intentionally NOT part of IronMapper.slnx.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Not the repository code style (root Directory.Build.props): the sources stand for a user's code and are also built
      with LangVersion 9 and 8 (no file-scoped namespace, no target-typed new). The IDE0005 variants turn it on with
      -p:EnforceCodeStyleInBuild=true and an .editorconfig of their own.
    -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <IronMapperVersion Condition="'$(IronMapperVersion)' == ''">$(Version)</IronMapperVersion>
    <IronMapperPackage Condition="'$(IronMapperPackage)' == ''">IronMapper</IronMapperPackage>
    <ConsumerSource Condition="'$(ConsumerSource)' == ''">Sources/NoUsing.cs</ConsumerSource>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ConsumerSource)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="$(IronMapperPackage)" Version="[$(IronMapperVersion)]" />
  </ItemGroup>

</Project>
