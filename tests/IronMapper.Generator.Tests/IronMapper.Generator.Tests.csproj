<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>IronMapper.Generator.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Snapshot tests of the generated code (GeneratedCodeSnapshotTests, Snapshots/*.verified.*). -->
    <PackageReference Include="Verify.Xunit" Version="31.12.5" />
    <PackageReference Include="Verify.SourceGenerators" Version="2.5.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Verified snapshots are generated code, not part of the test assembly. -->
    <Compile Remove="Snapshots\**" />
    <None Include="Snapshots\**" />
    <!-- DiagnosticHelpLinkTests: every helpLinkUri needs its section in the docs. -->
    <None Include="..\..\docs\diagnostics.md;..\..\docs\diagnostics.ru.md" Link="Docs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IronMapper\IronMapper.csproj" />
    <ProjectReference Include="..\..\src\IronMapper.Generator\IronMapper.Generator.csproj" />
    <!-- RuntimeMapper is exercised against in-memory compilations (GeneratedClassVisibilityTests). -->
    <ProjectReference Include="..\..\src\IronMapper.Extensions.DI\IronMapper.Extensions.DI.csproj" />
  </ItemGroup>

</Project>
