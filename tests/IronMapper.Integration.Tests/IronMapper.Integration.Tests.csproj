<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- QualifiedNameMapperTests maps one source to two MemberDto types on purpose (qualified method names). -->
    <NoWarn>$(NoWarn);IM0013</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <!-- GeneratedTypeNamesArchitectureTests: layer rules over two assemblies with mappings. -->
    <PackageReference Include="TngTech.ArchUnitNET.xUnit" Version="0.13.4" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IronMapper\IronMapper.csproj" />
    <ProjectReference Include="..\..\src\IronMapper.Extensions.DI\IronMapper.Extensions.DI.csproj" />
    <!-- Multi-project IMapper test (MapperRegistryAssemblyTests): entities in Domain, mappings in Application. -->
    <ProjectReference Include="..\IronMapper.Integration.Domain\IronMapper.Integration.Domain.csproj" />
    <ProjectReference Include="..\IronMapper.Integration.Application\IronMapper.Integration.Application.csproj" />
    <!-- Generator runs at compile time so the test assembly contains the generated extension methods. -->
    <ProjectReference Include="..\..\src\IronMapper.Generator\IronMapper.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
