<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Library referenced by IronMapper.PackageConsumer: uses the packed IronMapper package and has only internal
    mappings, so its IronMapper.Generated.GeneratedMappers must be internal and invisible to the consumer.
    Built by eng/verify-package.ps1 through the consumer; intentionally NOT part of IronMapper.slnx.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IronMapperVersion Condition="'$(IronMapperVersion)' == ''">$(Version)</IronMapperVersion>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IronMapper" Version="[$(IronMapperVersion)]" />
  </ItemGroup>

</Project>
