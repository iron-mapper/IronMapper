<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NativeAOT probe B: IMapper from IronMapper.Extensions.DI is not AOT-compatible yet (plan item 1.3, issue #26), and
    publishing must say so at the application's own call. eng/verify-aot.ps1 publishes it for net8.0 and net10.0 and
    requires IL2026 on the AddIronMapper line of Program.cs and no other trim/AOT warning (in particular no summary
    IL2104 for an IronMapper assembly). The executable is not run. Intentionally NOT part of IronMapper.slnx.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The expected warning; everything else stays an error. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026</WarningsNotAsErrors>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IronMapperVersion Condition="'$(IronMapperVersion)' == ''">$(Version)</IronMapperVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IronMapper.Extensions.DI" Version="[$(IronMapperVersion)]" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

</Project>
