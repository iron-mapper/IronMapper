<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <!--
      Code style of .editorconfig is checked in the build (warnings are errors). AnalysisLevelStyle is needed too: the
      ':warning' of an "option = value:warning" line applies in the build only with an analysis level for style, and
      netstandard projects (the generator, the code fixes, the netstandard builds of the libraries) have none by default,
      so they were not checked at all. Code generated into user projects is not affected: analyzers skip
      <auto-generated> files, and nothing of this is packed.
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevelStyle>10.0</AnalysisLevelStyle>

    <Version>2.0.0</Version>
    <Authors>Aleksey Mironov</Authors>
    <Company>Aleksey Mironov</Company>
    <Copyright>Copyright (c) 2026 Aleksey Mironov</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/iron-mapper/IronMapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iron-mapper/IronMapper</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/iron-mapper/IronMapper/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
