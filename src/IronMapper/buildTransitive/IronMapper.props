<Project>

  <!--
    Adds `global using IronMapper.Generated;` (the namespace of the generated MapTo* methods) to C# projects with
    implicit usings, so a missing using no longer fails with CS1061. Opt out with
    <IronMapperImplicitUsings>false</IronMapperImplicitUsings>.
    This file is imported before the project file, but item conditions are evaluated after all properties, so
    ImplicitUsings, LangVersion and IronMapperImplicitUsings set in the project (or Directory.Build.props) are seen.
    buildTransitive/ also applies to projects that reference only IronMapper.Extensions.DI.
  -->
  <ItemGroup Condition="'$(Language)' == 'C#'
                        and ('$(ImplicitUsings)' == 'enable' or '$(ImplicitUsings)' == 'true')
                        and '$(IronMapperImplicitUsings)' != 'false'">
    <Using Include="IronMapper.Generated" />
  </ItemGroup>

  <!--
    MSBuild properties the source generator reads (as build_property.* analyzer config options):
    IronMapperReportUnmappedInProfiles - true reports IM0001 for destination properties of profile (CreateMap) mappings
    that nothing maps; off by default in 1.x. Severity as for any diagnostic, e.g. in .editorconfig:
    dotnet_diagnostic.IM0001.severity = error
    IronMapperGenerateInPlace, IronMapperGenerateList, IronMapperGenerateArray - false stops generating the public
    in-place overload, MapToXList, MapToXArray of every mapping (a mapping can override it); true by default.
    IronMapperExcludeFromCodeCoverage - true marks the generated class with [ExcludeFromCodeCoverage]; false by default.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="IronMapperReportUnmappedInProfiles" />
    <CompilerVisibleProperty Include="IronMapperGenerateInPlace" />
    <CompilerVisibleProperty Include="IronMapperGenerateList" />
    <CompilerVisibleProperty Include="IronMapperGenerateArray" />
    <CompilerVisibleProperty Include="IronMapperExcludeFromCodeCoverage" />
  </ItemGroup>

</Project>
