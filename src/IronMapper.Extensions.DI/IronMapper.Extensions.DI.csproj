<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <PackageId>IronMapper.Extensions.DI</PackageId>
    <RootNamespace>IronMapper.Extensions.DI</RootNamespace>
    <AssemblyName>IronMapper.Extensions.DI</AssemblyName>
    <PackageDescription>Microsoft.Extensions.DependencyInjection integration for IronMapper: registers an IMapper that calls the generated mapping methods through a generated registry (no reflection; works with trimming and NativeAOT).</PackageDescription>
    <PackageTags>mapper;automapper;dto;object-mapping;source-generator;dependency-injection;aspnetcore</PackageTags>
  </PropertyGroup>

  <!--
    Trim and AOT analyzers for the net10.0 build: every reflection use must be annotated (RequiresUnreferencedCode),
    so applications get IL2026 at their own call instead of a summary IL2104 for this assembly. The netstandard
    build gets the same attributes from Polyfills/ (no analyzers there).
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- Keeps the generated registration for IMapper in a trimmed / NativeAOT publish (see IronMapper's buildTransitive targets). -->
    <None Include="buildTransitive\IronMapper.Extensions.DI.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none": let the IronMapper source generator flow to consumers of this package. -->
    <ProjectReference Include="..\IronMapper\IronMapper.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
