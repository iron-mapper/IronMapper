<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <PackageId>IronMapper.Extensions.DI</PackageId>
    <RootNamespace>IronMapper.Extensions.DI</RootNamespace>
    <AssemblyName>IronMapper.Extensions.DI</AssemblyName>
    <PackageDescription>Microsoft.Extensions.DependencyInjection integration for IronMapper: registers an IMapper that dispatches to the generated mapping methods. Note: IMapper locates and invokes those methods via reflection.</PackageDescription>
    <PackageTags>mapper;automapper;dto;object-mapping;source-generator;dependency-injection;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none": let the IronMapper source generator flow to consumers of this package. -->
    <ProjectReference Include="..\IronMapper\IronMapper.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
