<Project>
  <!--
    Own props for the comparison benchmarks. Deliberately does NOT import the repository root
    Directory.Build.props: that one turns on TreatWarningsAsErrors, GenerateDocumentationFile,
    the package Version and NuGet packaging properties, none of which belong here.
  -->
  <!--
    Target frameworks. The suite itself (src/ and tests/) also targets net8.0 (LTS), so the runtime scenarios can be
    measured on both: dotnet run -c Release -f net8.0 ... The reference runtime of the published results is net10.0.
    The probes (cold start, NativeAOT, size, build time) and tools/ stay on net10.0 only.
  -->
  <PropertyGroup>
    <ComparisonTargetFrameworks>net10.0;net8.0</ComparisonTargetFrameworks>
    <_ComparisonProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_ComparisonProjectDir>
    <_IsComparisonSuiteProject Condition="$(_ComparisonProjectDir.StartsWith($([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'src')), StringComparison.OrdinalIgnoreCase)) Or $(_ComparisonProjectDir.StartsWith($([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'tests')), StringComparison.OrdinalIgnoreCase))">true</_IsComparisonSuiteProject>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks Condition="'$(_IsComparisonSuiteProject)' == 'true'">$(ComparisonTargetFrameworks)</TargetFrameworks>
    <TargetFramework Condition="'$(_IsComparisonSuiteProject)' != 'true'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      IronMapper source: the published NuGet package (default) or the local sources in ../src.
      Maintainer switch: dotnet run -c Release -f net10.0 -p:UseLocalIronMapper=true
    -->
    <UseLocalIronMapper Condition="'$(UseLocalIronMapper)' == ''">false</UseLocalIronMapper>
    <IronMapperSrcDir>$(MSBuildThisFileDirectory)..\src\</IronMapperSrcDir>
    <!-- Folder with locally packed IronMapper packages (IronMapperPackageVersion, see Directory.Packages.props). -->
    <RestoreAdditionalProjectSources Condition="'$(IronMapperPackageSource)' != ''">$(RestoreAdditionalProjectSources);$(IronMapperPackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
