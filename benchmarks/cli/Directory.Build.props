<Project>
  <!--
    Own props for the benchmark CLI. MSBuild uses the nearest Directory.Build.props and does not import the one in
    benchmarks/: its IronMapper switches (UseLocalIronMapper, IronMapperPackageVersion, also as environment variables)
    have nothing to do with the CLI and must not break its build.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
