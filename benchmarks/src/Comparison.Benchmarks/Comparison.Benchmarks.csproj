<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Comparison.Benchmarks</RootNamespace>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Comparison.Mappers\Comparison.Mappers.csproj" />
    <!-- Extern alias: its IronMapper.Generated.GeneratedMappers would clash with the one in Comparison.Mappers. -->
    <ProjectReference Include="..\Comparison.Mappers.IronMapperStaticFormat\Comparison.Mappers.IronMapperStaticFormat.csproj"
                      Aliases="StaticFormat" />
  </ItemGroup>

</Project>
