<Project>
  <!-- Central Package Management: every package version used by the comparison benchmarks. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    IronMapper package version. Default: the published release the suite compares against. run-all.ps1
    -UseLocalIronMapper packs ../src as <Version>-local.<timestamp> and sets IronMapperPackageVersion and
    IronMapperPackageSource (environment variables) for the steps that measure what a package user gets: cold start,
    NativeAOT, size, build time.
  -->
  <PropertyGroup>
    <IronMapperPackageVersion Condition="'$(IronMapperPackageVersion)' == ''">1.1.3</IronMapperPackageVersion>
  </PropertyGroup>

  <ItemGroup Label="Mappers under test">
    <PackageVersion Include="IronMapper" Version="$(IronMapperPackageVersion)" />
    <PackageVersion Include="IronMapper.Extensions.DI" Version="$(IronMapperPackageVersion)" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="Mapster" Version="10.0.13" />
    <PackageVersion Include="Mapster.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="AutoMapper" Version="16.2.0" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
