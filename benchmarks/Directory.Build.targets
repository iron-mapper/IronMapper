<Project>
  <!--
    IronMapper references for projects that set UsesIronMapper / UsesIronMapperDI = true.
    Lives in .targets (not .props) so the project-level properties are already defined here.
  -->
  <ItemGroup Condition="'$(UsesIronMapper)' == 'true' And '$(UseLocalIronMapper)' != 'true'">
    <PackageReference Include="IronMapper" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsesIronMapperDI)' == 'true' And '$(UseLocalIronMapper)' != 'true'">
    <PackageReference Include="IronMapper.Extensions.DI" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsesIronMapper)' == 'true' And '$(UseLocalIronMapper)' == 'true'">
    <ProjectReference Include="$(IronMapperSrcDir)IronMapper\IronMapper.csproj" />
    <ProjectReference Include="$(IronMapperSrcDir)IronMapper.Generator\IronMapper.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsesIronMapperDI)' == 'true' And '$(UseLocalIronMapper)' == 'true'">
    <ProjectReference Include="$(IronMapperSrcDir)IronMapper.Extensions.DI\IronMapper.Extensions.DI.csproj" />
  </ItemGroup>

  <!--
    What the packages add through buildTransitive, for the local sources (project references get nothing from there):
    the feature switch of the IMapper registration (off for a NativeAOT publish without the DI package), so the AOT
    size of the local sources is measured as a package user gets it.
  -->
  <PropertyGroup Condition="'$(UsesIronMapperDI)' == 'true' And '$(UseLocalIronMapper)' == 'true'">
    <_IronMapperExtensionsDIReferenced>true</_IronMapperExtensionsDIReferenced>
  </PropertyGroup>
  <Import Project="$(IronMapperSrcDir)IronMapper\buildTransitive\IronMapper.targets"
          Condition="'$(UsesIronMapper)' == 'true' And '$(UseLocalIronMapper)' == 'true'" />

  <!--
    IronMapper 2.0 names the generated class GeneratedMappers_{AssemblyName} (1.1.x: GeneratedMappers in every assembly).
    Code that names the class (the extern alias StaticFormat) checks IRONMAPPER_CLASS_PER_ASSEMBLY: set for the local
    sources and for a package version 2 or later (IronMapperPackageVersion, Directory.Packages.props).
  -->
  <PropertyGroup Condition="'$(UseLocalIronMapper)' != 'true' And '$(IronMapperPackageVersion)' != ''">
    <_IronMapperPackageMajor>$([System.Version]::Parse($(IronMapperPackageVersion.Split('-')[0])).Major)</_IronMapperPackageMajor>
    <_IronMapperPackageMinor>$([System.Version]::Parse($(IronMapperPackageVersion.Split('-')[0])).Minor)</_IronMapperPackageMinor>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseLocalIronMapper)' == 'true'">
    <DefineConstants>$(DefineConstants);IRONMAPPER_CLASS_PER_ASSEMBLY;IRONMAPPER_NESTED_OBJECTS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_IronMapperPackageMajor)' != '' And $(_IronMapperPackageMajor) &gt;= 2">
    <DefineConstants>$(DefineConstants);IRONMAPPER_CLASS_PER_ASSEMBLY</DefineConstants>
  </PropertyGroup>
  <!--
    IronMapper 2.1 maps nested objects by the mappings of their type pairs (1.1.x and 2.0.x: MapFrom that calls the
    generated method). The profiles check IRONMAPPER_NESTED_OBJECTS: set for the local sources and for a package 2.1 or later.
  -->
  <PropertyGroup Condition="'$(_IronMapperPackageMajor)' != '' And ($(_IronMapperPackageMajor) &gt; 2 Or ($(_IronMapperPackageMajor) == 2 And $(_IronMapperPackageMinor) &gt;= 1))">
    <DefineConstants>$(DefineConstants);IRONMAPPER_NESTED_OBJECTS</DefineConstants>
  </PropertyGroup>

  <!--
    The ../src projects are not part of IronMapper.Comparison.slnx. In a solution build MSBuild strips
    Configuration from references to projects outside the solution, so `-c Release` would build them
    as Debug. Keep Configuration on every reference into ../src (direct and transitive), and drop
    BuildingSolutionFile there so the references between the ../src projects keep it as well.
  -->
  <PropertyGroup Condition="'$(UseLocalIronMapper)' == 'true'">
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>
  <Target Name="_KeepConfigurationForLocalIronMapper"
          Condition="'$(UseLocalIronMapper)' == 'true'"
          DependsOnTargets="IncludeTransitiveProjectReferences"
          BeforeTargets="AssignProjectConfiguration">
    <PropertyGroup>
      <_IronMapperSrcFullDir>$([System.IO.Path]::GetFullPath('$(IronMapperSrcDir)'))</_IronMapperSrcFullDir>
    </PropertyGroup>
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)"
                        Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(_IronMapperSrcFullDir)', StringComparison.OrdinalIgnoreCase))"
                        UndefineProperties="%(ProjectReference.UndefineProperties);BuildingSolutionFile" />
    </ItemGroup>
  </Target>
</Project>
