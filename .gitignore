## .NET / C# gitignore

# Build outputs
[Oo]bj/
[Bb]in/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# NuGet packages
*.nupkg
*.snupkg
packages/
!**/packages/build/
.nuget/

# MSBuild
project.lock.json
project.fragment.lock.json
artifacts/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
.idea/

# Rider
*.sln.iml

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml
coverage-report/

# BenchmarkDotNet results
BenchmarkDotNet.Artifacts/

# User-specific files
*.rsuser
*.pidb
*.booproj
*.svd

# Roslyn cache
*.glyph

# .NET Core
project.lock.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Env / secrets
.env
.env.local
*.secrets.json
appsettings.Development.json

# Generated sources (optional — can keep for debugging)
# Uncomment to ignore generated source files:
# *.g.cs

# Claude
.claude/
/agents/api-checker-agent.md
/agents/review-agent.md
/agents/test-agent.md
